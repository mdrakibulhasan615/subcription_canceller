# No secrets here. Copy to .env.local and fill in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional. Public site URL, for example https://app.example.com.
NEXT_PUBLIC_SITE_URL=
# Google sign-in for the local Supabase CLI only. Put real values in supabase/.env (git-ignored).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Optional. Sentry DSN. Leave empty to turn error reports off.
NEXT_PUBLIC_SENTRY_DSN=
# Public contact email shown on the legal pages and error pages.
NEXT_PUBLIC_CONTACT_EMAIL=
